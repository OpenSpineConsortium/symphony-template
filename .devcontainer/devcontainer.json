{
  "name": "Symphony setup",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "cpus": 2
  },
  "postCreateCommand": "bash scripts/codespace.sh install",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "docs/setup/codespace.md"
      ]
    },
    "vscode": {
      "settings": {
        "task.allowAutomaticTasks": "on"
      }
    }
  }
}
